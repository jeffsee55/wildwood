# Local development uses a SQLite file when DATABASE_URL is unset.
# Vercel requires a persistent remote LibSQL/Turso database.
WILDWOOD_DOCS_DATABASE_URL=
WILDWOOD_DOCS_DATABASE_TOKEN=

# Exact hosted origin, e.g. https://wildwood-docs.vercel.app (no trailing slash).
WILDWOOD_DOCS_ORIGIN=http://localhost:3000

# GitHub OAuth sign-in. Callback: <origin>/cms/auth/callback/github
WILDWOOD_DOCS_GITHUB_CLIENT_ID=
WILDWOOD_DOCS_GITHUB_CLIENT_SECRET=
WILDWOOD_DOCS_OWNER_EMAIL=

# Existing integrations may use TURSO_DATABASE_URL / TURSO_AUTH_TOKEN and
# GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET; the app accepts those aliases.
# Auth signing material is generated once and persisted in the database.
# Local owner sign-in is never enabled in production.
